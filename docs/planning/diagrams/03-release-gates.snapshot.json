{
  "kind": "flowchart",
  "draft": false,
  "version": 2,
  "elements": [
    {
      "$type": "mermaiden.diagrams.flowchart.elements:Start",
      "fields": {
        "id": "ready",
        "label": "Start | Modwire and Enclosure candidates"
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.elements:Action",
      "fields": {
        "id": "build",
        "label": "Build artifacts | wheel + sdist + Docker image"
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.elements:Action",
      "fields": {
        "id": "prove",
        "label": "Prove | behavior, speed, MCP, snapshot recovery"
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.elements:Decision",
      "fields": {
        "id": "gate",
        "label": "All acceptance evidence passes?"
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.elements:Action",
      "fields": {
        "id": "repair",
        "label": "Repair owning issue | rerun affected gates"
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.elements:Action",
      "fields": {
        "id": "publish",
        "label": "Publish Modwire stable | verify registry artifact"
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.elements:Action",
      "fields": {
        "id": "lock",
        "label": "Lock stable Modwire in Enclosure | rebuild + retest"
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.elements:Action",
      "fields": {
        "id": "deploy",
        "label": "Release Enclosure | migrate, deploy, smoke test"
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.elements:End",
      "fields": {
        "id": "close",
        "label": "Close epic | receipts + guidance updated"
      }
    }
  ],
  "relations": [
    {
      "$type": "mermaiden.diagrams.flowchart.relations:Flow",
      "fields": {
        "id": "r_build",
        "label": "",
        "element_ids": [
          "ready",
          "build"
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.relations:Flow",
      "fields": {
        "id": "b_prove",
        "label": "",
        "element_ids": [
          "build",
          "prove"
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.relations:Flow",
      "fields": {
        "id": "p_gate",
        "label": "",
        "element_ids": [
          "prove",
          "gate"
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.relations:ConditionalFlow",
      "fields": {
        "id": "failed",
        "label": "no",
        "element_ids": [
          "gate",
          "repair"
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.relations:Flow",
      "fields": {
        "id": "retry",
        "label": "",
        "element_ids": [
          "repair",
          "build"
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.relations:ConditionalFlow",
      "fields": {
        "id": "passed",
        "label": "yes",
        "element_ids": [
          "gate",
          "publish"
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.relations:Flow",
      "fields": {
        "id": "pub_lock",
        "label": "",
        "element_ids": [
          "publish",
          "lock"
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.relations:Flow",
      "fields": {
        "id": "lock_deploy",
        "label": "",
        "element_ids": [
          "lock",
          "deploy"
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.relations:Flow",
      "fields": {
        "id": "deploy_close",
        "label": "",
        "element_ids": [
          "deploy",
          "close"
        ]
      }
    }
  ],
  "properties": {
    "direction": {
      "$enum": "mermaiden.diagrams.flowchart.elements:Direction",
      "value": "TD"
    }
  },
  "annotations": [
    {
      "$type": "mermaiden.diagrams.flowchart.annotations:Note",
      "fields": {
        "id": "correctness",
        "text": "Benchmark native + Docker: cold, warm, edit, add/delete/rename. Verify cache invalidation on config/version/root changes and cold/warm report parity.",
        "targets": [
          {
            "$type": "mermaiden.core.domain:TargetRef",
            "fields": {
              "id": "prove",
              "kind": {
                "$enum": "mermaiden.core.domain:TargetKind",
                "value": "element"
              }
            }
          }
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.annotations:Note",
      "fields": {
        "id": "mcp_gate",
        "text": "FOUND: healthy architecture can hide broken MCP. Verify required context, empty collections, reads and continuation through MCP.",
        "targets": [
          {
            "$type": "mermaiden.core.domain:TargetRef",
            "fields": {
              "id": "prove",
              "kind": {
                "$enum": "mermaiden.core.domain:TargetKind",
                "value": "element"
              }
            }
          }
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.annotations:Note",
      "fields": {
        "id": "snapshot_gate",
        "text": "Mermaiden 6 rejects v2 snapshots. Inventory, back up, migrate and test restore; image rollback alone cannot undo data changes.",
        "targets": [
          {
            "$type": "mermaiden.core.domain:TargetRef",
            "fields": {
              "id": "deploy",
              "kind": {
                "$enum": "mermaiden.core.domain:TargetKind",
                "value": "element"
              }
            }
          }
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.annotations:Note",
      "fields": {
        "id": "publication",
        "text": "Verify PyPI ownership/publisher, helper package data and shared workflow references. Keep old repositories/releases usable until consumer cutover is proven.",
        "targets": [
          {
            "$type": "mermaiden.core.domain:TargetRef",
            "fields": {
              "id": "publish",
              "kind": {
                "$enum": "mermaiden.core.domain:TargetKind",
                "value": "element"
              }
            }
          }
        ]
      }
    },
    {
      "$type": "mermaiden.diagrams.flowchart.annotations:Note",
      "fields": {
        "id": "health_coverage",
        "text": "Gate: merged shape/boundary rules cover extraction, architecture and CLI. Require the expected nonempty map and passing real health; never weaken rules for green.",
        "targets": [
          {
            "$type": "mermaiden.core.domain:TargetRef",
            "fields": {
              "id": "prove",
              "kind": {
                "$enum": "mermaiden.core.domain:TargetKind",
                "value": "element"
              }
            }
          }
        ]
      }
    }
  ],
  "configuration": {
    "$type": "mermaiden.diagrams.flowchart.configuration:FlowchartDiagramConfiguration",
    "fields": {
      "wrap": true
    }
  }
}
