include LICENSE
include README.md
recursive-include src *.py *.typed *.php *.js *.mjs *.ts *.json *.lock *.md *.yaml
recursive-include tests *.py *.json *.ts *.tsx *.js *.jsx *.php *.java
recursive-include scripts *.py
prune verification
prune .dev
prune src/modwire/extraction/extractors/resources/typescript/node_modules
prune src/modwire/extraction/extractors/resources/php/vendor
prune src/modwire/extraction/extractors/resources/java/target
global-exclude __pycache__ *.py[cod]
