#!/usr/bin/env python3
import json
import os
import subprocess
import sys

completed = subprocess.run(
    [os.environ["EXAMPLE_NODE"], *sys.argv[1:]],
    input=sys.stdin.buffer.read() if "--batch" in sys.argv else None,
    capture_output=True,
)
sys.stderr.buffer.write(completed.stderr)
if completed.returncode or "--batch" not in sys.argv:
    sys.stdout.buffer.write(completed.stdout)
    sys.exit(completed.returncode)

records = completed.stdout.decode().splitlines()
mode = os.environ["EXAMPLE_OUTPUT"]
if mode == "duplicate":
    records.append(records[0])
elif mode == "missing":
    records.pop()
elif mode == "unexpected":
    record = json.loads(records[-1])
    record[0] = "example_unexpected.ts"
    records[-1] = json.dumps(record)
elif mode == "invalid":
    records.append("{")
print("\n".join(records), end="\n" if records else "")
